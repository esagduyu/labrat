# ============================================================
# LabRat .gitignore
# ============================================================

# ─── Private project docs (keep these OUT of public repo) ───
# These are your internal planning and orchestration documents.
# Remove these lines if you ever want to publish them.
PROJECT_PLAN.md
BUILDER_PROMPT.md
CONTEXT/
competitive_intelligence.md
spider2_improvement_plan.md
blogs/
docs/superpowers/specs/2026-06-01-labrat-north-star-design.md
docs/superpowers/specs/2026-07-10-commercial-model-memo.md
FEATURE_ROADMAP.md

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── uv ──────────────────────────────────────────────────────
.venv/
.venv.bak/
# Note: uv.lock SHOULD be committed (it's the lockfile)
# Note: .python-version is debatable; we recommend committing for reproducibility

# ─── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
# pytest-textual-snapshot diff outputs (snapshots themselves are committed)
**/__snapshots__/__diff_output__/

# ─── Type checking ───────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.pyre/
.pytype/

# ─── Linting ─────────────────────────────────────────────────
.ruff_cache/

# ─── Documentation builds ────────────────────────────────────
docs/_build/
docs/_static/
docs/_templates/
site/

# ─── Jupyter (in case any debugging notebooks slip in) ───────
.ipynb_checkpoints
*.ipynb

# ─── IDEs and editors ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.~lock.*

# ─── OS files ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Environment and secrets ─────────────────────────────────
.env
.env.local
.env.*.local
.envrc
# Never commit API keys
*api_key*
*apikey*
*.pem
*.key
*.crt

# ─── LabRat-specific runtime artifacts ───────────────────────
# Eval outputs (large, regeneratable)
eval-results/
benchmark-results/

# Local LabRat state if it ever lands in repo (it shouldn't; it lives in ~/.local)
.labrat/
.labrat-cache/

# DuckDB / SQLite local artifacts
*.duckdb-wal
*.duckdb-shm
*.duckdb.tmp
*.sqlite-wal
*.sqlite-shm
*.db-journal

# Test databases (large fixture files; regenerate via seed scripts)
tests/fixtures/sample_dbs/*.duckdb
tests/fixtures/sample_dbs/*.parquet
# But keep the seed scripts themselves
!tests/fixtures/sample_dbs/.gitkeep

# Test dbt project compiled artifacts (regenerated by dbt parse)
tests/fixtures/sample_dbt_projects/**/target/
tests/fixtures/sample_dbt_projects/**/dbt_packages/
tests/fixtures/sample_dbt_projects/**/logs/

# Screenshots and recordings (regeneratable, large)
*.png
*.gif
*.mp4
*.webm
*.mov
# But keep mascot art and required assets
!src/labrat/assets/*.txt
!src/labrat/assets/*.png
!assets/mascot_*.txt

# Profiling outputs
*.prof
*.lprof

# ─── AutoResearch ────────────────────────────────────────────
# results.tsv is untracked (à la Karpathy's autoresearch)
results.tsv
# dbt execution work dirs (can be large)
autoresearch_output/

# ─── Local-only verification / trace-bundle helpers ──────────
# DAB PR #54 transparency session (2026-06-03): trace-bundle builder.
# The bundle, zip, and PR reply draft live under runs/ (already ignored).
scripts/_build_dab_trace_bundle.py

# ─── Misc ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
.cache/
# ─── Eval output ─────────────────────────────────────────────────────────────
eval_output/
test_output/
runs/
# screenshots/ is tracked — milestone SVGs live in screenshots/
docs/superpowers/specs/2026-06-01-codex-subscription-provider-design.md
